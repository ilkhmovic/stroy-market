SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Productionda DEBUG=False bo'lsa SECRET_KEY majburiy.
# ALLOWED_HOSTS vergul bilan: example.com,www.example.com
# DATABASE_URL=postgres://user:password@host:port/dbname

GEMINI_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_MANAGER_CHAT_ID=

# Django admin manzili (oxirida / bo'lishi shart emas)
ADMIN_URL=admin/

# Footer aloqa (bo'sh qoldirilsa ko'rsatilmaydi)
SUPPORT_PHONE=
SUPPORT_EMAIL=

# Faqat DEBUG=False da ishlaydi
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=60

# Alohida domenlar (ixtiyoriy). ALLOWED_HOSTS ga ham qo'shing.
# SELLER_HOST=seller.example.uz
# ADMIN_HOST=admin.example.uz

# ── Email (tasdiqlash xatlari). Bo'sh bo'lsa xatlar terminalga chop etiladi ──
# Gmail: Google akkaunt -> Xavfsizlik -> 2 bosqichli tasdiqlash -> "App passwords" (oddiy parol ISHLAMAYDI)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=ArzonMaterial <sizning@gmail.com>
