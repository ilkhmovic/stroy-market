msgstr "У этого аккаунта нет прав администратора."

msgid "Bu email bilan akkaunt allaqachon mavjud."
msgstr "Аккаунт с таким email уже существует."

msgid "Bu funksiya xaridorlar uchun."
msgstr "Эта функция только для покупателей."

msgid "Bu sahifa sizning rolingiz uchun emas."
msgstr "Эта страница недоступна для вашей роли."

msgid "Do'kon"
msgstr "Магазин"

msgid "Do'kon egasimisiz?"
msgstr "Вы владелец магазина?"

msgid "Do'kon mavjud emas"
msgstr "Магазин не найден"

msgid "Do'kon oching"
msgstr "Откройте магазин"

msgid "Do'kon oching va mahsulotlaringizni soting"
msgstr "Откройте магазин и продавайте свои товары"

msgid "Do'koningizni boshqaring"
msgstr "Управляйте своим магазином"

msgid "Email manzilingiz"
msgstr "Ваш email"

msgid "Email tasdiqlandi! Endi tizimga kirishingiz mumkin."
msgstr "Email подтверждён! Теперь вы можете войти."

msgid ""
"Emailingiz hali tasdiqlanmagan. Pochtangizga yuborilgan havolani bosing "
"(Spam papkasini ham tekshiring). Yangi tasdiqlash xati yuborildi."
msgstr ""
"Ваш email ещё не подтверждён. Перейдите по ссылке из письма (проверьте и "
"папку «Спам»). Новое письмо отправлено."

msgid "Faqat PDF/JPG/PNG/WEBP, eng ko‘pi 10 MB."
msgstr "Только PDF/JPG/PNG/WEBP, не более 10 МБ."

msgid "Faqat kutilayotgan mahsulotni bekor qilish mumkin."
msgstr "Отменить можно только ожидающий товар."

msgid "Fayl formati tekshiruvdan o‘tmadi."
msgstr "Формат файла не прошёл проверку."

msgid "Fayl va izoh yuboring."
msgstr "Отправьте файл и описание."

msgid "Hali sotuvchi emasmisiz?"
msgstr "Ещё не продаёте на маркете?"

msgid "Izoh 4000 belgidan oshmasin."
msgstr "Описание не должно превышать 4000 символов."

msgid "Loyiha o‘lchamlari/izohi yoki smeta faylini kiriting."
msgstr "Укажите размеры/описание проекта или загрузите файл сметы."

msgid "Mahsulot bekor qilindi, zaxira qaytarildi."
msgstr "Товар отменён, остаток возвращён на склад."

msgid ""
"Ombordagi qoldiq savat uchun yetarli emas: %(name)s (qoldiq %(stock)s)."
msgstr ""
"Остатка на складе недостаточно для корзины: %(name)s (остаток %(stock)s)."

msgid "STIR 9 ta, PINFL 14 ta raqamdan iborat bo'lishi kerak."
msgstr "ИНН должен состоять из 9 цифр, ПИНФЛ — из 14."

msgid "Savat miqdori butun dona bo‘lishi kerak."
msgstr "Количество в корзине должно быть целым числом."

msgid "Savat so‘rovi noto‘g‘ri."
msgstr "Некорректный запрос корзины."

msgid "Smetani tahlil qilib bo‘lmadi. Birozdan so‘ng qayta urinib ko‘ring."
msgstr "Не удалось проанализировать смету. Попробуйте чуть позже."

msgid "Sotuvchi bo'lish"
msgstr "Стать продавцом"

msgid "Sotuvchi kabiniga kirish"
msgstr "Вход в кабинет продавца"

msgid "Sotuvchi paneli"
msgstr "Панель продавца"

msgid "Sotuvchi portali"
msgstr "Портал продавца"

msgid "Sotuvchi portaliga kiring"
msgstr "Войдите в портал продавца"

msgid "Sotuvchilar uchun"
msgstr "Для продавцов"

msgid "Tasdiqlash xati shu manzilga yuboriladi"
msgstr "Письмо с подтверждением будет отправлено на этот адрес"

msgid ""
"Tasdiqlash xatini yuborib bo'lmadi. Kirish sahifasida parolingizni kiriting,"
" xat qayta yuboriladi."
msgstr ""
"Не удалось отправить письмо с подтверждением. Введите пароль на странице "
"входа, и письмо отправится снова."

msgid "Xarid qilish uchun akkaunt yarating"
msgstr "Создайте аккаунт, чтобы покупать"

msgid "Xaridor akkaunti"
msgstr "Аккаунт покупателя"

msgid "Xaridor saytiga qaytish"
msgstr "Вернуться на сайт покупателя"
