+    {% for field in form %}
+    <div>
+        <label for="{{ field.id_for_label }}" class="block text-gray-700 text-sm font-bold mb-1.5">{{ field.label }}</label>
+        {{ field }}
+        {% if field.help_text %}<p class="text-[11px] text-gray-400 mt-1">{{ field.help_text|safe }}</p>{% endif %}
